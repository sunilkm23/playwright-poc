PLAYWRIGHT_SERVICE_URL=

KEY_VAULT_URL=

# ---------------------------------------------------------------------------
# Tricentis qTest integration — native Playwright reporter
# Set QTEST_ENABLED=true to upload final execution status to qTest after a run.
# ---------------------------------------------------------------------------
# Enable/disable the qTest reporter (no code changes needed)
QTEST_ENABLED=false

# Target execution cycle — REQUIRED when QTEST_ENABLED=true.
# Accepts a cycle pid/name (e.g. CL-125) or a numeric cycle id.
QTEST_CYCLE_ID=

# qTest connectivity — REQUIRED when QTEST_ENABLED=true
QTEST_BASE_URL=
QTEST_PROJECT_ID=
QTEST_API_TOKEN=

# Optional overrides
# Module tree:  <Orphaned Test Cases> / <Playwright> / <CYCLE_ID>
# QTEST_ORPHANED_MODULE=Orphaned Test Cases  # top-level module new TCs land under
# QTEST_ROOT_MODULE=Playwright               # framework root module
#
# Suite naming (JUnit testsuite equivalent):
#   file     → spec file name, e.g. agreement-search.spec.ts (default, recommended)
#   describe → top-level describe() title (falls back to file)
#   project  → browser/project name, e.g. chromium
#   fixed    → a single fixed name from QTEST_SUITE_NAME
# QTEST_SUITE_STRATEGY=file
# QTEST_SUITE_NAME=Playwright_CL-125         # only used when strategy=fixed
# QTEST_SUITE_INCLUDE_PROJECT=false          # prefix suite with browser name
#
# Force-approve test cases whose version is not a major (N.0) release
# QTEST_AUTO_APPROVE=true
# QTEST_CACHE_FILE=.cache/qtestCache.json

# Back-compat: QTEST_TOKEN is accepted as an alias for QTEST_API_TOKEN.
QTEST_TOKEN=